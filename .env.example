# GridWise Environment Configuration Example
# Copy this file to .env and insert your real OpenRouter API key

# OpenRouter API credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Identifier (canonical: google/gemini-2.5-flash for sub-3s latency)
LLM_MODEL=google/gemini-2.5-flash

# Base URL for OpenRouter API
LLM_BASE_URL=https://openrouter.ai/api/v1

# API Server Host & Port
HOST=0.0.0.0
PORT=8000
